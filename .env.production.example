# Copy to .env.production and fill in. Start with:
#   docker compose --env-file .env.production up -d --build
# (the same file feeds both the app and the compose variables below).

# --- Public address -------------------------------------------------------------------------------
# The domain Caddy serves and gets the HTTPS certificate for.
MAGISTRAL_DOMAIN=magistral.duckdns.org
# The same address as a full URL: allowed host, links and OAuth callbacks.
MAGISTRAL_PUBLIC_URL=https://magistral.duckdns.org
# Shows the "Versão de teste" badge; remove for the final release.
MAGISTRAL_RELEASE_CHANNEL=teste

# --- Secrets --------------------------------------------------------------------------------------
# Encrypts integration credentials at rest. Generate once with: openssl rand -base64 48
MAGISTRAL_SECRET_KEY=
# Optional fixed code for creating the first admin at /configurar (otherwise it is printed in the logs).
MAGISTRAL_SETUP_TOKEN=
# Optional four-digit PIN that hides the Sistema section behind an unlock dialog (empty: no lock).
MAGISTRAL_SYSTEM_PIN=
# Optional six-digit PIN that hides Desenvolvimento (Uso, Integrações) behind its own dialog (empty: no lock).
MAGISTRAL_DEV_PIN=

# --- AI provider ----------------------------------------------------------------------------------
# openrouter (default), gemini or anthropic. The free OpenRouter tier allows only 50 requests a day:
# buy credits (1,000/day) or use a paid model for a test with several people.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# DEMONSTRATION ONLY: "true" also routes to free providers that may store prompts or train on them. It
# makes the free models far more available, but party data and documents may be kept by third parties:
# use only fictitious data. Leave it empty (or remove it) for real use, together with a paid model.
OPENROUTER_ALLOW_DATA_COLLECTION=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=local

# --- DuckDNS (optional updater: docker compose --profile duckdns ...) ------------------------------
DUCKDNS_SUBDOMAIN=magistral
DUCKDNS_TOKEN=
