# Drafting provider: openrouter (default), gemini or anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional comma-separated fallback list of OpenRouter model ids. Requests only go to zero-data-retention
# endpoints, so every model must have one: https://openrouter.ai/api/v1/endpoints/zdr
OPENROUTER_MODELS=
# Optional: "true" also allows providers that may store or train on prompts (most free models)
OPENROUTER_ALLOW_DATA_COLLECTION=
# Optional: only needed when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Library search embeddings: local (default, runs on the CPU, no key) or gemini
EMBEDDING_PROVIDER=local
# Folder for the local SQLite database and downloaded models (default: ./data)
MAGISTRAL_DATA_DIR=
# Folder mirrored by "Sincronizar pasta" on /biblioteca (default: <data dir>/biblioteca)
MAGISTRAL_LIBRARY_DIR=
# Hostnames the office uses to reach the server besides localhost, IP addresses and *.local (comma-separated)
MAGISTRAL_ALLOWED_HOSTS=
# pnpm dev only: hosts other devices use to reach the dev server, e.g. 192.168.1.6 (comma-separated)
MAGISTRAL_DEV_ORIGINS=
# Optional fixed code for creating the first admin at /configurar (default: random, printed in the server log)
MAGISTRAL_SETUP_TOKEN=
# Optional four-digit PIN that hides the Sistema section behind an unlock dialog (empty: no lock)
MAGISTRAL_SYSTEM_PIN=
# Optional six-digit PIN that hides Desenvolvimento (Uso, Integrações) behind its own dialog (empty: no lock)
MAGISTRAL_DEV_PIN=
